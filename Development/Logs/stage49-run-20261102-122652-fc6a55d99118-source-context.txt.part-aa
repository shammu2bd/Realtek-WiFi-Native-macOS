   82 
  100         if (!ticket)
  101             return;
  102         ticket->packet = nullptr;
  103         ticket->transmitted = 0;
  104         __atomic_store_n(&ticket->state, kFree, __ATOMIC_RELEASE);
  105     }
  106 
  107     static void *packet(const Ticket *ticket)
  109         return ticket ? ticket->packet : nullptr;
  110     }
  111 
  112     static bool transmitted(const Ticket *ticket)
  113     {
  114         return ticket && ticket->transmitted != 0;
  115     }
  116 
  117     bool hasOutstanding() const
  118     {
  119         for (uint32_t i = 0; i < Capacity; ++i) {
  120             if (__atomic_load_n(&_slots[i].state, __ATOMIC_ACQUIRE) != kFree)
  121                 return true;
  123         return false;
  124     }
  125 
  126     uint32_t outstandingCount() const
