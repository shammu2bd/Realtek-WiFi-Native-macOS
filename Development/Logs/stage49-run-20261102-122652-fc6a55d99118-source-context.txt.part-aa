  262 bool RTW88WCLInfraInterface::start(IOService *provider)
  263 {
  264     /* The native controller has not yet completed PCI/DMA ownership transfer,
  265      * Skywalk registration-info allocation or RX/TX ring registration. Never
  266      * publish a half-initialized Wi-Fi service. */
  267     if (provider) {
  268         provider->setProperty("RTW88WCLInfraInterfaceStage",
  269                               "24H32 protocol handlers; Skywalk datapath pending");
  273 
  274 void RTW88WCLInfraInterface::stop(IOService *provider)
  275 {
  276     clearRegistrationInfo();
  277     detachRadio();
  278     if (provider)
  279         provider->setProperty("RTW88WCLInfraInterfaceStopped", kOSBooleanTrue);
  280     super::stop(provider);
  287         return kIOReturnNotReady;
  288 
  289     /* Bring the RTW88 station path up first. Only then may the controller's
  290      * standard mbuf TX hook admit packets for this registered interface. */
  291     IOReturn status = _bridge.powerOn();
  292     if (status != kIOReturnSuccess)
  293         return status;
  294 
  306     if (!_bridge.isAttached() || !_controller)
  307         return kIOReturnNotReady;
  308 
  309     /* Stop new mbuf submissions and wait for synchronous TX handoffs before
  310      * asking RTW88 to power down. A busy path leaves the radio running. */
  311     IOReturn status = _controller->quiescePacketPath();
  312     if (status != kIOReturnSuccess)
  313         return status;

