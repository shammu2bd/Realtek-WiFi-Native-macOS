  169 bool RTW88WCLSkywalkRxAdapter::checkForWork()
  170 {
  171     if (__atomic_load_n(&_stopping, __ATOMIC_ACQUIRE))
  172         return false;
  173 
  176     while (drained < kDrainBudget && _frames.pop(&source)) {
  177         if (source) {
  178             IOSkywalkPacket *packet = nullptr;
  179             if (copyMbufToSkywalkPacket(_rxPool, source, &packet)) {
  180                 __atomic_add_fetch(&_prepared, 1U, __ATOMIC_RELAXED);
  181                 /* A true return means the sink has accepted ownership. The
  182                  * current controller sink returns false because the RX
  183                  * completion queue is still unregistered. */
  184                 const bool accepted = _sink && _sink(packet, _sinkContext);
  185                 if (!accepted) {
  186                     (void)_rxPool->deallocatePacket(packet);
  187                     __atomic_add_fetch(&_dropped, 1U, __ATOMIC_RELAXED);
  188                 }
  189             } else {
  190                 __atomic_add_fetch(&_dropped, 1U, __ATOMIC_RELAXED);
  209     return false;
  210 }
  211 
  212 void RTW88WCLSkywalkRxAdapter::stop()
  213 {
  214     __atomic_store_n(&_stopping, 1U, __ATOMIC_RELEASE);
  215     if (_registered && _workLoop) {
  216         /* Synchronous removal serializes against checkForWork(). The owner
  217          * must stop/quiesce RTW88 RX producers before invoking stop(). */
  218         _workLoop->removeEventSource(this);
  219         _registered = false;
  220     }
  221 
  228     _sink = nullptr;
  229     _sinkContext = nullptr;
  230     _workLoop = nullptr;
  231     if (_rxPool) {
  232         _rxPool->release();
  233         _rxPool = nullptr;
  234     }
  235 }
  236 
  237 void RTW88WCLSkywalkRxAdapter::free()
  238 {
  239     stop();
  240     super::free();
  241 }
  242 
  243 uint32_t RTW88WCLSkywalkRxAdapter::droppedFrames() const
  244 {
  245     return __atomic_load_n(&_dropped, __ATOMIC_ACQUIRE);
  246 }
  247 
  248 uint32_t RTW88WCLSkywalkRxAdapter::preparedFrames() const
  249 {
  250     return __atomic_load_n(&_prepared, __ATOMIC_ACQUIRE);
  251 }
  252 
  253 uint32_t RTW88WCLSkywalkRxAdapter::queuedFrames() const
  254 {
  255     return _frames.approximateSize();
  256 }
