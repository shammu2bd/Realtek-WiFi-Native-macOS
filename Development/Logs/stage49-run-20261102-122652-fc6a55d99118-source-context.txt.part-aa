  139 
  140 /*
  141  * Sequoia 24H32 callback contract: although the bundled Skywalk action
  144  * that no packets were accepted or completed. Do not return nonzero
  145  * IOReturn error constants from these action callbacks.
  146  */
  147 IOReturn RTW88WCLSkywalkQueues::txSubmissionAction(
  148     OSObject *owner, IOSkywalkTxSubmissionQueue *queue,
  149     const IOSkywalkPacket **packets, UInt32 packetCount, void *refCon)
  150 {
  151     (void)refCon;
  152     auto *self = OSDynamicCast(RTW88WCLSkywalkQueues, owner);
  153     if (!self || queue != self->_txSubmission || !packets || packetCount == 0)
  154         return static_cast<IOReturn>(0);
  155 
  156     /* Validate every descriptor before a future TX path is allowed to copy
  157      * bytes or hand ownership to RTW88. The callback remains fail-closed:
  158      * a validated packet is not yet accepted until its hardware completion
  159      * cookie is connected to the native completion queue. */
  160     for (UInt32 i = 0; i < packetCount; ++i) {
  161         if (!packets[i])
  162             return static_cast<IOReturn>(0);
  163         RTW88WCLPacketView view = {};
  164         if (!RTW88WCLResolveEthernetTxPacket(
  165                 const_cast<IOSkywalkPacket *>(packets[i]), self->_txPool, &view))
  166             return static_cast<IOReturn>(0);
  167     }
  168 
  169     return static_cast<IOReturn>(0);
  170 }
  171 
  172 IOReturn RTW88WCLSkywalkQueues::txCompletionAction(
  173     OSObject *owner, IOSkywalkTxCompletionQueue *queue,
  174     IOSkywalkPacket **packets, UInt32 packetCount, void *refCon)
  175 {
  176     (void)owner; (void)queue; (void)packets; (void)packetCount; (void)refCon;
  177     return static_cast<IOReturn>(0);
  178 }
  179 
  180 IOReturn RTW88WCLSkywalkQueues::rxSubmissionAction(
  181     OSObject *owner, IOSkywalkRxSubmissionQueue *queue,
  182     const IOSkywalkPacket **packets, UInt32 packetCount, void *refCon)
  183 {
  184     (void)owner; (void)queue; (void)packets; (void)packetCount; (void)refCon;
  185     /* RX buffer ownership/refill is intentionally not accepted yet. */
  186     return static_cast<IOReturn>(0);
  187 }
  188 
  189 IOReturn RTW88WCLSkywalkQueues::rxCompletionAction(
  190     OSObject *owner, IOSkywalkRxCompletionQueue *queue,
  191     IOSkywalkPacket **packets, UInt32 packetCount, void *refCon)
  192 {
  193     (void)owner; (void)queue; (void)packets; (void)packetCount; (void)refCon;
  194     return static_cast<IOReturn>(0);

