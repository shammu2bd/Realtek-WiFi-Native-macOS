   13 class RTW88IEEE80211;
   14 
   15 class RTW88WCLSkywalkTxAdapter final : public OSObject {
   16     OSDeclareDefaultStructors(RTW88WCLSkywalkTxAdapter)
   17 
   18 public:
   19     using CompletionSink = void (*)(IOSkywalkPacket *packet,
   20                                     bool transmitted,
   21                                     void *context);
   22 
   23     static constexpr uint32_t kCompletionCapacity = 128;
   24 
   25     bool init() override;
   26     IOReturn bind(RTW88IEEE80211 *radio,
   27                   IOSkywalkPacketBufferPool *txPool);
   28     IOReturn unbind();
   29 
   30     /* Copies a validated, single-buffer Skywalk Ethernet frame to an mbuf,
   31      * then submits it to RTW88 with a bounded completion ticket. Ownership of
   32      * the Skywalk packet stays with this adapter until drainCompletions(). */
   33     IOReturn submitPacket(IOSkywalkPacket *packet);
   34 
   35     /* Must be called later from a serialized/deferred context. The sink may
   36      * enqueue the packet to Skywalk's TX-completion queue once that queue's
   37      * ABI and lifecycle have been validated. The adapter releases its packet
   38      * retain after the sink returns. */
   39     uint32_t drainCompletions(CompletionSink sink, void *context);
   40 
   41     bool hasOutstandingCompletions() const;
   42     uint32_t outstandingCompletionCount() const;
   43     void free() override;
   44 
   45 private:
   46     using TicketPool = RTW88WCLTxCompletionSlots<kCompletionCapacity>;
   47 
   48     static void backendCompletion(void *context, void *cookie,
   49                                   bool transmitted);
   50     static mbuf_t copyPacketToMbuf(const uint8_t *bytes, uint32_t length);
   51 
   52     RTW88IEEE80211 *_radio = nullptr; // retained while bound
   53     IOSkywalkPacketBufferPool *_txPool = nullptr; // retained while bound
   54     TicketPool _tickets;
   55 };

