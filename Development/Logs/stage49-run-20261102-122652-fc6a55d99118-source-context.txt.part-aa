    1 /* SPDX-License-Identifier: GPL-2.0-only
    2  * Opaque IOSkywalk RegistrationInfo storage and the verified Apple 24H32
    3  * post-initializer writes. Field semantics intentionally remain unnamed.
    4  */
    5 #pragma once
    6 
    8 #include <stdint.h>
    9 #include <string.h>
   10 
   11 namespace RTW88WCLRegistrationInfo24H32 {
   12 
   13 constexpr size_t kSize = 0x130;
   14 constexpr uint64_t kVersionAndSize = 0x0000013000000001ULL;
   15 
   30 struct alignas(8) Storage {
   31     uint8_t bytes[kSize];
   32 };
   33 static_assert(sizeof(Storage) == kSize, "24H32 RegistrationInfo storage size");
   34 static_assert(alignof(Storage) >= 8, "24H32 RegistrationInfo alignment");
   35 static_assert(kOpaqueSlot0C + sizeof(uint32_t) <= kSize,
   36               "24H32 opaque slot 0x0c is in bounds");
   37 static_assert(kOpaqueSlot14 + sizeof(uint32_t) <= kSize,
   38               "24H32 opaque slot 0x14 is in bounds");
   73 }
   74 
   75 /* Apply only the fields written by Apple's 24H32 createSkywalkInterface
   76  * caller after initRegistrationInfo(). The initializer itself remains a
   77  * separate kernel call because it populates other values from virtual hooks.
   78  */
   79 inline bool applyAppleProducerWrites(Storage &storage,
   80                                      const uint8_t hardwareAddress[6])
   90     return true;
   91 }
   92 
   93 /* Called only after the kernel initRegistrationInfo() method has returned
   94  * true and applyAppleProducerWrites() has run.
   95  */
   96 inline bool matchesApple24H32Template(const Storage &storage,
   97                                       const uint8_t hardwareAddress[6])
  111     return memcmp(storage.bytes + kHardwareAddress, hardwareAddress, 6) == 0;
  112 }
  113 
  114 } // namespace RTW88WCLRegistrationInfo24H32

