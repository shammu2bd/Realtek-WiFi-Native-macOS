   12 #define super OSObject
   13 OSDefineMetaClassAndStructors(RTW88WCLSkywalkTxAdapter, OSObject)
   14 
   15 bool RTW88WCLSkywalkTxAdapter::init()
   16 {
   17     if (!super::init())
   18         return false;
   19     _radio = nullptr;
   20     _txPool = nullptr;
   21     _tickets.reset();
   22     return true;
   23 }
   24 
   25 IOReturn RTW88WCLSkywalkTxAdapter::bind(
   26     RTW88IEEE80211 *radio, IOSkywalkPacketBufferPool *txPool)
   27 {
   28     if (!radio || !txPool)
   29         return kIOReturnBadArgument;
   30     if (_radio || _txPool || _tickets.hasOutstanding())
   31         return kIOReturnBusy;
   32 
   33     radio->retain();
   34     txPool->retain();
   35     _radio = radio;
   36     _txPool = txPool;
   37     return kIOReturnSuccess;
   38 }
   39 
   40 IOReturn RTW88WCLSkywalkTxAdapter::unbind()
   41 {
   42     if (_tickets.hasOutstanding())
   43         return kIOReturnBusy;
   44 
   45     RTW88IEEE80211 *radio = _radio;
   46     IOSkywalkPacketBufferPool *pool = _txPool;
   47     _radio = nullptr;
   48     _txPool = nullptr;
   49     if (pool)
   50         pool->release();
   51     if (radio)
   52         radio->release();
   53     return kIOReturnSuccess;
   54 }
   55 
   56 mbuf_t RTW88WCLSkywalkTxAdapter::copyPacketToMbuf(
   57     const uint8_t *bytes, uint32_t length)
   58 {
   59     if (!bytes || length < 14 || length > 2048)
   60         return nullptr;
   73     return mbuf;
   74 }
   75 
   76 IOReturn RTW88WCLSkywalkTxAdapter::submitPacket(IOSkywalkPacket *packet)
   77 {
   78     if (!packet)
   79         return kIOReturnBadArgument;
   80     if (!_radio || !_txPool)
   81         return kIOReturnNotReady;
   82 
   83     RTW88WCLPacketView view = {};
   84     if (!RTW88WCLResolveEthernetTxPacket(packet, _txPool, &view))
   85         return kIOReturnBadArgument;
   86 
   87     mbuf_t mbuf = copyPacketToMbuf(view.bytes, view.length);
   88     if (!mbuf)
  100      * this ticket. backendCompletion() intentionally does not release it. */
  101     retain();
  102     const UInt32 backendResult = _radio->outputPacketWithCompletion(
  103         mbuf, &RTW88WCLSkywalkTxAdapter::backendCompletion, this, ticket);
  104 
  105     /* outputPacketWithCompletion consumes the mbuf and reports exactly one
  106      * terminal callback, including synchronous drops. Once the ticket has
  107      * been reserved, adapter acceptance is successful; the actual transmitted
  108      * vs dropped result is delivered later through the completion sink. */
  109     (void)backendResult;
  110     return kIOReturnSuccess;
  111 }
  112 
  113 void RTW88WCLSkywalkTxAdapter::backendCompletion(
  114     void *context, void *cookie, bool transmitted)
  115 {
  116     auto *self = static_cast<RTW88WCLSkywalkTxAdapter *>(context);
  117     auto *ticket = static_cast<TicketPool::Ticket *>(cookie);
  118     if (!self || !ticket)
  119         return;
  120 
  121     /* No Skywalk API, OSObject release, allocation, or blocking operation is
  122      * allowed here. A deferred consumer performs the completion handoff. */
  123     (void)TicketPool::complete(ticket, transmitted);
  124 }
  125 
  126 uint32_t RTW88WCLSkywalkTxAdapter::drainCompletions(
  127     CompletionSink sink, void *context)
  128 {
  129     if (!sink)
  130         return 0;
  139             break;
  140 
  141         auto *packet = static_cast<IOSkywalkPacket *>(TicketPool::packet(ticket));
  142         const bool transmitted = TicketPool::transmitted(ticket);
  143 
  144         /* The sink runs in deferred context and borrows the retained packet.
  145          * It must finish any Skywalk queue handoff before returning. */
  146         if (packet)
  147             sink(packet, transmitted, context);
  148 
  149         TicketPool::finish(ticket);
  150         if (packet)
  151             packet->release();
  156     return drained;
  157 }
  158 
  159 bool RTW88WCLSkywalkTxAdapter::hasOutstandingCompletions() const
  160 {
  161     return _tickets.hasOutstanding();
  162 }
  163 
  164 uint32_t RTW88WCLSkywalkTxAdapter::outstandingCompletionCount() const
  165 {
  166     return _tickets.outstandingCount();
  167 }
  168 
  169 void RTW88WCLSkywalkTxAdapter::free()
  170 {
  171     /* A per-ticket retain prevents free() while hardware callbacks are still
  172      * pending. The owning controller must drain every completion before its
  173      * final reference is released. */
  174     if (_tickets.hasOutstanding())
  175         IOLog("rtl88wifi-wcl: TX adapter free attempted with outstanding tickets\n");
  176     unbind();
  177     super::free();
  178 }

