===== src/compat/linux/skbuff_tx_completion.h =====
TOTAL_LINES=97
MATCH_LINES=29
    4  * The token is separately allocated from the skb. A racing kfree_skb() may
    5  * reclaim the skb immediately after another thread claims the token, so no
    6  * callback state may remain embedded in the skb after the atomic claim.
    7  * Callbacks may run from TX completion or arbitrary free/teardown context;
    8  * they must be non-blocking and must not call Skywalk directly.
    9  */
   10 #ifndef _RTW88_COMPAT_SKBUFF_TX_COMPLETION_H
   11 #define _RTW88_COMPAT_SKBUFF_TX_COMPLETION_H
   12 
   13 #include <stdbool.h>
   14 
   15 #ifdef __cplusplus
   16 extern "C" {
   17 #endif
   18 
   19 typedef void (*rtw88_skb_tx_completion_fn)(void *context, void *cookie,
   20                                            bool transmitted);
   21 typedef void (*rtw88_skb_tx_completion_release_fn)(void *token);
   22 
   23 struct rtw88_skb_tx_completion_token {
   24     rtw88_skb_tx_completion_fn callback;
   25     rtw88_skb_tx_completion_release_fn release;
   26     void *context;
   27     void *cookie;
   28 };
   29 
   30 /* This one pointer is the only completion state stored inside struct sk_buff. */
   31 struct rtw88_skb_tx_completion {
   32     struct rtw88_skb_tx_completion_token *token;
   33 };
   34 
   35 static inline bool
   36 rtw88_skb_tx_completion_bind(
   37     struct rtw88_skb_tx_completion *completion,
   38     struct rtw88_skb_tx_completion_token *token)
   39 {
   40     if (!completion || !token || !token->callback || !token->release)
   41         return false;
   42 
   43     struct rtw88_skb_tx_completion_token *expected = 0;
   44     /* Publish a fully initialized, independently allocated token atomically. */
   45     return __atomic_compare_exchange_n(&completion->token, &expected, token,
   46                                        false, __ATOMIC_RELEASE,
   47                                        __ATOMIC_RELAXED);
   51  * Claim the token with one atomic exchange. After this returns, callers must
   52  * not touch completion again: the skb may be freed by the losing free path.
   53  */
   54 static inline struct rtw88_skb_tx_completion_token *
   55 rtw88_skb_tx_completion_claim(struct rtw88_skb_tx_completion *completion)
   56 {
   57     if (!completion)
   58         return 0;
   59     return __atomic_exchange_n(&completion->token,
   60                                (struct rtw88_skb_tx_completion_token *)0,
   61                                __ATOMIC_ACQ_REL);
   62 }
   63 
   64 /* Dispatch uses only the detached token, never memory owned by the skb. */
   65 static inline bool
   66 rtw88_skb_tx_completion_dispatch(
   67     struct rtw88_skb_tx_completion_token *token, bool transmitted)
   68 {
   69     if (!token)
   70         return false;
   71 
   72     rtw88_skb_tx_completion_fn callback = token->callback;
   73     rtw88_skb_tx_completion_release_fn release = token->release;
   74     void *context = token->context;
   75     void *cookie = token->cookie;
   76 
   77     if (callback)
   78         callback(context, cookie, transmitted);
   79     if (release)
   80         release(token);
   81     return callback != 0;
   82 }
   83 
   84 static inline bool
   85 rtw88_skb_tx_completion_report(struct rtw88_skb_tx_completion *completion,
   86                                bool transmitted)
   87 {
   88     struct rtw88_skb_tx_completion_token *token =
   89         rtw88_skb_tx_completion_claim(completion);
   90     return rtw88_skb_tx_completion_dispatch(token, transmitted);
   91 }
   92 
   93 #ifdef __cplusplus
   94 }
   95 #endif
   96 
   97 #endif /* _RTW88_COMPAT_SKBUFF_TX_COMPLETION_H */

