  212  */
  213 extern thread_call_t    thread_call_allocate_with_options(
  214 	thread_call_func_t      func,
  215 	thread_call_param_t     param0,
  222  *  @abstract Release a thread call.
  223  *  @discussion Should only be used on thread calls allocated with thread_call_allocate
  224  *  or thread_call_allocate_with_priority.  Once thread_call_free has been called,
  225  *  no other operations may be performed on a thread call.  If the thread call is
  226  *  currently pending, thread_call_free will return FALSE and will have no effect.
  227  *  Calling thread_call_free from a thread call's own callback is safe; the work
  228  *  item is not considering "pending" at that point.
  229  *  @result TRUE if the thread call has been successfully released, else FALSE.
  230  *  @param call The thread call to release.
  231  */
  232 extern boolean_t        thread_call_free(
  233 	thread_call_t           call);
