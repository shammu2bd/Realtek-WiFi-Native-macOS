   35 static inline bool
   36 rtw88_skb_tx_completion_bind(
   37     struct rtw88_skb_tx_completion *completion,
   38     struct rtw88_skb_tx_completion_token *token)
   39 {
   40     if (!completion || !token || !token->callback || !token->release)
   41         return false;
   42 
   43     struct rtw88_skb_tx_completion_token *expected = 0;
   44     /* Publish a fully initialized, independently allocated token atomically. */
   45     return __atomic_compare_exchange_n(&completion->token, &expected, token,
   46                                        false, __ATOMIC_RELEASE,
   47                                        __ATOMIC_RELAXED);
   67     struct rtw88_skb_tx_completion_token *token, bool transmitted)
   68 {
   69     if (!token)
   70         return false;
   71 
   72     rtw88_skb_tx_completion_fn callback = token->callback;
   73     rtw88_skb_tx_completion_release_fn release = token->release;
   74     void *context = token->context;
   75     void *cookie = token->cookie;
   76 
   77     if (callback)
   78         callback(context, cookie, transmitted);
   79     if (release)
   80         release(token);
   81     return callback != 0;
   82 }
   83 
