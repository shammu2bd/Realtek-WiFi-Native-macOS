===== src/compat/linux/skbuff_tx_completion.h MATCHES=8 =====
    1 /* SPDX-License-Identifier: GPL-2.0-only
    2  * Exactly-once completion token for the macOS sk_buff compatibility layer.
    3  *
    4  * The token is separately allocated from the skb. A racing kfree_skb() may
    5  * reclaim the skb immediately after another thread claims the token, so no
    6  * callback state may remain embedded in the skb after the atomic claim.
    7  * Callbacks may run from TX completion or arbitrary free/teardown context;
    8  * they must be non-blocking and must not call Skywalk directly.
    9  */
   10 #ifndef _RTW88_COMPAT_SKBUFF_TX_COMPLETION_H
   11 #define _RTW88_COMPAT_SKBUFF_TX_COMPLETION_H
   12 
