  775 /*!
  779  * Requests data from a nonlocalized resource file in a kext bundle on disk.
  780  *
  781  * @param  kextIdentifier  The CFBundleIdentifier of the kext
  782  *                         from which to read the file.
  783  * @param  resourceName    The name of the resource file to read.
  784  * @param  callback        A pointer to a callback function; the address
  785  *                         must be within a currently-loaded kext.
  786  * @param  context         A pointer to arbitrary run-time data
  787  *                         that will be passed to the callback
  788  *                         when it is invoked. May be <code>NULL</code>.
  789  * @param  requestTagOut   If non-<code>NULL</code>,
  790  *                         filled on success with a tag identifying the
  791  *                         pending request
  792  *                         (or on failure with <code>@link kOSKextRequestTagInvalid
  793  *                         kOSKextRequestTagInvalid@/link</code>;
  794  *                         can be used with
  798  * @result
  799  * <code>@link kOSReturnSuccess kOSReturnSuccess@/link</code>
  800  * if the request is successfully queued.
  801  * <code>@link kOSKextReturnInvalidArgument kOSKextReturnInvalidArgument@/link</code>
  802  * if <code>kextIdentifier</code> or <code>resourceName</code> or if
  803  * <code>callback</code> is not an address within a loaded kext executable.
  804  * <code>@link kOSKextReturnStopping kOSKextReturnStopping@/link</code>
  805  * if an unload attempt is being made
  806  * on the kext containing <code>callback</code>.
  807  * Other <code>OSKextReturn...</code> errors are possible.
  808  *
  809  * @discussion
  810  * This function queues an asynchronous request to the user-space kext daemon
  811  * <code>@link //apple_ref/doc/man/8/kextd kextd(8)@/link</code>;
  812  * requests for resources early in system startup
  813  * will not be fulfilled until that daemon starts.
  814  * Requests made by a kext while that kext is loading
  815  * (specifically in the kext's module start routine)
  816  * will not be fulfilled until after the start routine returns and
  817  * the kext is completely loaded.
  818  * Kexts requesting resources should be sure to perform appropriate locking
  819  * in the callback function.
  820  *
  821  * Kext resources are stored in the kext's on-disk bundle under the
  822  * Resources subdirectory.
  823  * See {@linkdoc //apple_ref/doc/uid/10000123i Bundle Programming Guide}
  824  * for an overview of bundle structure.
  825  * The localization context of the kext daemon
  826  * (namely that of the superuser)
  827  * will be used in retrieving resources;
  828  * kext resources intended for use in the kernel
  829  * should generally not be localized.
  830  *
  831  * <code>callback</code> is guaranteed to be invoked except when:
  832  * <ul>
  833  * <li>@link OSKextCancelRequest <code>OSKextCancelRequest</code>@/link
  834  *     is used to cancel the request.
  835  *     In this case the kext gets the <code>context</code> pointer
  836  *     and can clean it up.</li>
  837  * <li>The request is made during a kext's module start routine
  838  *     and the start routine returns an error.
  839  *     In this case, callbacks cannot be safely invoked, so
  840  *     the kext should clean up all request contexts
  841  *     when returning the error from the start routine.</li>
  842  * </ul>
  843  *
  844  * Kexts with pending requests are not subject to autounload,
  845  * but requests are subject to timeout after a few minutes.
  846  * If that amount of time passes with no response from user space,
  847  * <code>callback</code> is invoked with a result of.
  848  * <code>@link kOSKextReturnTimeout kOSKextReturnTimeout@/link</code>.
  849  *
  850  * Kexts that are explicitly unloaded have all pending request callbacks
  851  * invoked with a result of
  852  * <code>@link kOSKextReturnStopping kOSKextReturnStopping@/link</code>.
  853  * The kext must handle these callbacks,
  854  * even if its stop routine will prevent unloading.
  855  * If the kext does prevent unloading, it can reissue resource requests
  856  * outside of the stop function.
  857  */
  858 OSReturn OSKextRequestResource(
  859 	const char                    * kextIdentifier,
  860 	const char                    * resourceName,
  861 	OSKextRequestResourceCallback   callback,
  862 	void                          * context,
  863 	OSKextRequestTag              * requestTagOut);
  864 
  865 /*!
  866  * @function OSKextCancelRequest
  867  *
  868  * @abstract
  869  * Cancels a pending user-space kext request without invoking the callback.
  870  *
  871  * @param  requestTag  A tag identifying a pending request.
  872  * @param  contextOut  If non-<code>NULL</code>, filled with the context pointer
  873  *                     originally passed with the request.
  874  *
  875  * @result
  876  * <code>@link kOSReturnSuccess kOSReturnSuccess@/link</code>
  879  * if <code>requestTag</code> does not identify any pending request.
  880  * Other <code>OSKextReturn...</code> errors are possible.
  881  *
  882  * @discussion
  883  * This function cancels a pending request if it exists,
  884  * so that its callback will not be invoked.
  885  * It returns in <code>contextOut</code>
  886  * the context pointer used to create the request
  887  * so that any resources allocated for the request can be cleaned up.
  888  *
  889  * Kexts do not need to cancel outstanding requests
  890  * in their module stop functions;
  891  * when a kext is unloaded, all pending request callbacks
  892  * are invoked with a result of
  893  * <code>@link kOSKextReturnTimeout kOSKextReturnTimeout@/link</code>
  894  * before the stop function is called.
  895  */
  896 OSReturn OSKextCancelRequest(
  897 	OSKextRequestTag    requestTag,
  898 	void             ** contextOut);

