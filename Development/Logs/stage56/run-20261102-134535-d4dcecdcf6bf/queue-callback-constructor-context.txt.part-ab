  755  *                             <code>@link kOSKextReturnStopping
  756  *                             kOSKextReturnStopping@/link</code>
  757  *                             if the kext containing the callback
  758  *                             address for the kext is being unloaded;
  759  *                             or other values on error.
  760  * @param  resourceData        A pointer to the requested resource data.
  761  *                             Owned by the system; the kext should make a copy
  762  *                             if it needs to keep the data past the callback.
  763  * @param  resourceDataLength  The length of <code>resourceData</code>.
  764  * @param  context             The context pointer originally passed to
  765  *                             <code>@link OSKextRequestResource
  766  *                             OSKextRequestResource@/link</code>.
  767  */
  768 typedef void (* OSKextRequestResourceCallback)(
  769 	OSKextRequestTag                requestTag,
  770 	OSReturn                        result,
  771 	const void                    * resourceData,
  772 	uint32_t                        resourceDataLength,
  773 	void                          * context);
