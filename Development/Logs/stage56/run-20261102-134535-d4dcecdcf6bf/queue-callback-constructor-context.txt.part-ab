  303 IOReturn RTW88WCLInfraInterface::disable(unsigned int options)
  304 {
  305     (void)options;
  306     if (!_bridge.isAttached() || !_controller)
  307         return kIOReturnNotReady;
  308 
  309     /* Stop new mbuf submissions and wait for synchronous TX handoffs before
  310      * asking RTW88 to power down. A busy path leaves the radio running. */
  312     if (status != kIOReturnSuccess)
  313         return status;
  314     return _bridge.powerOff();
