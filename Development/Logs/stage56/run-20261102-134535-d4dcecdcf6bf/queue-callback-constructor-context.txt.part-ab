   84 /*!
   85  *  @function thread_call_enter
   86  *  @abstract Submit a thread call work item for immediate execution.
   87  *  @discussion If the work item is already scheduled for delayed execution, and it has
   88  *  not yet begun to run, that delayed invocation will be cancelled.  Note that if a
   89  *  thread call is rescheduled from its own callback, then multiple invocations of the
   90  *  callback may be in flight at the same time.
   91  *  @result TRUE if the call was already pending for either delayed or immediate
   92  *  execution, FALSE otherwise.
   93  *  @param call The thread call to execute.
   94  */
   95 extern boolean_t        thread_call_enter(
   96 	thread_call_t           call);
   97 /*!
   98  *  @function thread_call_enter1
   99  *  @abstract Submit a thread call work item for immediate execution, with an extra parameter.
  100  *  @discussion This routine is identical to thread_call_enter(), except that
  101  *  the second parameter to the callback is specified.
  102  *  @result TRUE if the call was already pending for either delayed or immediate
  103  *  execution, FALSE otherwise.
  104  *  @param call The thread call to execute.
  105  *  @param param1 Parameter to pass callback.
  106  */
  107 extern boolean_t        thread_call_enter1(
  108 	thread_call_t           call,
  109 	thread_call_param_t     param1);
  110 
  111 /*!
  112  *  @function thread_call_enter_delayed
  113  *  @abstract Submit a thread call to be executed at some point in the future.
  114  *  @discussion If the work item is already scheduled for delayed or immediate execution,
  115  *  and it has not yet begun to run, that invocation will be cancelled in favor of execution
  116  *  at the newly specified time.  Note that if a thread call is rescheduled from its own callback,
  117  *  then multiple invocations of the callback may be in flight at the same time.
  118  *  @result TRUE if the call was already pending for either delayed or immediate
  119  *  execution, FALSE otherwise.
  120  *  @param call The thread call to execute.
  121  *  @param deadline Time, in absolute time units, at which to execute callback.
  122  */
  123 extern boolean_t        thread_call_enter_delayed(
  124 	thread_call_t           call,
  125 	uint64_t                deadline);
  126 /*!
  127  *  @function thread_call_enter1_delayed
  128  *  @abstract Submit a thread call to be executed at some point in the future, with an extra parameter.
  129  *  @discussion This routine is identical to thread_call_enter_delayed(),
  130  *  except that a second parameter to the callback is specified.
  131  *  @result TRUE if the call was already pending for either delayed or immediate
  132  *  execution, FALSE otherwise.
  133  *  @param call The thread call to execute.
  134  *  @param param1 Second parameter to callback.
  135  *  @param deadline Time, in absolute time units, at which to execute callback.
  136  */
  137 extern boolean_t        thread_call_enter1_delayed(
  138 	thread_call_t           call,
  139 	thread_call_param_t     param1,
  140 	uint64_t                deadline);
  141 
  142 /*!
  144  *  @abstract Attempt to cancel a pending invocation of a thread call.
  145  *  @discussion Attempt to cancel a thread call which has been scheduled
  146  *  for execution with a thread_call_enter* variant.  If the call has not
  147  *  yet begun executing, the pending invocation will be cancelled and TRUE
  148  *  will be returned.  If the work item has already begun executing,
  149  *  thread_call_cancel will return FALSE immediately; the callback may be
  150  *  about to run, currently running, or already done executing.
  151  *  @result TRUE if the call was successfully cancelled, FALSE otherwise.
  152  */
  153 extern boolean_t        thread_call_cancel(
  154 	thread_call_t           call);
