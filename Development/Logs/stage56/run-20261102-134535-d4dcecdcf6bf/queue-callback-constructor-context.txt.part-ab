   56 mbuf_t RTW88WCLSkywalkTxAdapter::copyPacketToMbuf(
   57     const uint8_t *bytes, uint32_t length)
   58 {
   59     if (!bytes || length < 14 || length > 2048)
   60         return nullptr;
   61 
   62     mbuf_t mbuf = nullptr;
   63     if (mbuf_allocpacket(MBUF_DONTWAIT, length, nullptr, &mbuf) != 0 || !mbuf)
   64         return nullptr;
   65 
   66     /* allocpacket may return a chain; copyback handles every segment. Keep
   67      * the copy non-blocking because this runs in a Skywalk queue callback. */
   68     if (mbuf_copyback(mbuf, 0, length, bytes, MBUF_DONTWAIT) != 0) {
   69         mbuf_freem(mbuf);
   70         return nullptr;
   71     }
   72     mbuf_pkthdr_setlen(mbuf, length);
   73     return mbuf;
   74 }
