  262 bool RTW88WCLInfraInterface::start(IOService *provider)
  263 {
  264     /* The native controller has not yet completed PCI/DMA ownership transfer,
  265      * Skywalk registration-info allocation or RX/TX ring registration. Never
  266      * publish a half-initialized Wi-Fi service. */
  267     if (provider) {
  268         provider->setProperty("RTW88WCLInfraInterfaceStage",
  269                               "24H32 protocol handlers; Skywalk datapath pending");
  270     }
  271     return false;
  272 }
