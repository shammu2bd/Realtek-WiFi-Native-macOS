  697 	struct IOEthernetAVBPacket;
  698 	
  699     /*! @typedef avb_packet_callback_t
  700      @abstract Callback function for handling received realtime or TimeSync packets
  701      @discussion Prototype for the callback function provided to the setRealtimeReceiveQueuePacketHandler(),
  702      addTimeSyncReceivePacketHandler() and addTimeSyncTransmitPacketHandler() functions for calling back to the requestor.
  703      @param context The context pointer that was provided in the call the registerForAVBStateChangeNotifications()
  704      @param packet The packet being received or transmitted.
  705      */
  706     typedef void (* avb_packet_callback_t)(void *context, struct IOEthernetAVBPacket *packet);
  707 
  708     /*! @struct IOEthernetAVBPacket
  709 		@abstract Structure containing an AVB or TimeSync packet.
  710 		@discussion Structure containing the metadata for an AVB or TimeSync packet.
  711 	    @field structVersion The version of the packet structure. The only defined version is version 0 and this field shall be set to 0.
  712 	    @field numberOfEntries The number of entries in the virtualRanges and physicalRanges fields that contain
  713 			valid addresses and lengths.
  716 		@field packetTimestamp The timestamp of the packet in mach_absolute_time() based time. For AVB realtime 
  717 			transmit packets this is the launch time of the packet, for AVB realtime receive packets this is 
  718 			optionally the ingress time of the packet. For TimeSync packets this is the egress time of transmitted
  719 			packets or the ingress time of received packets.
  720 		@field timestampValid Indicates if the packetTimestamp field contains a valid value.
  721 		@field transmittedTimeSyncCallbackRef For transmited egress time stamped packets the callback reference
  722 			returned by calling addTimeSyncTransmitPacketHandler(). This is required when calling transmitTimeSyncPacket().
  723 	    @field vlanTag The VLAN tag associated with the packet (includes the VLAN ID, Priority Code Point and Drop Eligable Indicator).
  724 		    This is typically used on receive paths to carry the VLAN tag that was stripped during reception.
  725 		@field desc_buffer A field for the allocator to keep track of the buffer for memory management purposes. Use is allocator defined.
  726 		@field desc_dma A field for the allocator to keep track of the DMA. Use is allocator defined.
  727 		@field completion_context A pointer value for use in the completion callback
  728 		@field completion_callback A callback function called by completeAVBPacket() to return the packet to the allocator when use is completed.
  729 	 */
  730 	typedef struct IOEthernetAVBPacket
  731 	{
  732 		int structVersion;
  733 		int numberOfEntries;
  734 		IOVirtualRange virtualRanges[kMaxIOEthernetReltimeEntries];
  735 		IOPhysicalRange physicalRanges[kMaxIOEthernetReltimeEntries];
  736 		uint64_t packetTimestamp;
  737 		bool timestampValid;
  738 		uint32_t transmittedTimeSyncCallbackRef;
  739 		
  740 		uint16_t vlanTag;
  741 		
  742 		void *desc_buffer;
  743 		void *desc_dma;
  744 		void *completion_context;
  745         avb_packet_callback_t completion_callback;
  746 		
  747 		void *reservedAVBStack;
  748 		void *reservedFamily;
  749 	} IOEthernetAVBPacket;
