  957 /*! @function registerForInterruptType
  958     @abstract Set callbacks for driver to call on interrupt events.
  959     @discussion The IOFramebuffer class will call its subclasses to set callbacks to be called on interrupt events generated by hardware events. Only two are currently in use - vertical blank interrupts and connection changed interrupts.
  960     @param interruptType One of these constants:<br>
  961     kIOFBVBLInterruptType Specifying a vertical blanking interrupt.
  962     kIOFBConnectInterruptType Specify the display connection should be resensed.
  963     @param proc C callback to be called by the driver when the specified event occurs.
  964     @param target Target parameter for the callback proc.
  965     @param ref Ref parameter for the callback proc.
  966     @param interruptRef The subclass should return an opaque reference to the installed interrupt handler, for use with unregisterInterrupt() and setInterruptState().
  967     @result An IOReturn code.
  968 */
  969 
  970     virtual IOReturn registerForInterruptType( IOSelect interruptType,
  971                     IOFBInterruptProc proc, OSObject * target, void * ref,
  972                     void ** interruptRef );
  973 
  974 /*! @function unregisterInterrupt
  975     @abstract Remove a callback previously installed by registerForInterruptType().
  976     @discussion Remove a callback previously installed by registerForInterruptType().
  977     @param interruptRef The interruptRef returned from the registerForInterruptType call that installed the interrupt.
  978     @result An IOReturn code.
  979 */
  980 
  981 #pragma clang diagnostic push
  982 #pragma clang diagnostic ignored "-Woverloaded-virtual"
  983     virtual IOReturn unregisterInterrupt( void * interruptRef );
  984 #pragma clang diagnostic pop
  985 
