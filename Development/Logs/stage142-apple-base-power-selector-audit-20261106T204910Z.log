METHOD=RTW88WCLInfraInterface::enable
METHOD_STATUS=FOUND
SOURCE|    (void)options;
SOURCE|    if (_stopping || !_bridge.isAttached() || !_controller)
SOURCE|        return kIOReturnNotReady;
SOURCE|    /* Bring the RTW88 station path up first. Only then may the controller's
SOURCE|     * standard mbuf TX hook admit packets for this registered interface. */
SOURCE|    IOReturn status = _bridge.powerOn();
SOURCE|    if (status != kIOReturnSuccess)
SOURCE|        return status;
SOURCE|    status = _controller->activatePacketPath(this);
SOURCE|    if (status != kIOReturnSuccess) {
SOURCE|        _bridge.powerOff();
SOURCE|        return status;
SOURCE|    }
SOURCE|    return kIOReturnSuccess;
CALLS_APPLE_INFRA_ENABLE=NO
CALLS_APPLE_INFRA_DISABLE=NO
CALLS_SKYWALK_SETTER=NO
CALLS_SKYWALK_ADVISORY=NO
CALLS_RADIO_POWER_ON=YES
CALLS_RADIO_POWER_OFF=YES
CALLS_PACKET_PATH_ACTIVATE=YES
CALLS_PACKET_PATH_QUIESCE=NO

METHOD=RTW88WCLInfraInterface::disable
METHOD_STATUS=FOUND
SOURCE|    (void)options;
SOURCE|    if (!_bridge.isAttached() || !_controller)
SOURCE|        return kIOReturnNotReady;
SOURCE|    /* Stop new mbuf submissions and wait for synchronous TX handoffs before
SOURCE|     * asking RTW88 to power down. A busy path leaves the radio running. */
SOURCE|    IOReturn status = _controller->quiescePacketPath();
SOURCE|    if (status != kIOReturnSuccess)
SOURCE|        return status;
SOURCE|    return _bridge.powerOff();
CALLS_APPLE_INFRA_ENABLE=NO
CALLS_APPLE_INFRA_DISABLE=NO
CALLS_SKYWALK_SETTER=NO
CALLS_SKYWALK_ADVISORY=NO
CALLS_RADIO_POWER_ON=NO
CALLS_RADIO_POWER_OFF=YES
CALLS_PACKET_PATH_ACTIVATE=NO
CALLS_PACKET_PATH_QUIESCE=YES

METHOD=RTW88WCLController::getPOWER
METHOD_STATUS=FOUND
SOURCE|    (void)interface;
SOURCE|    if (!data)
SOURCE|        return kIOReturnBadArgument;
SOURCE|    bzero(data, sizeof(*data));
SOURCE|    data->version = APPLE80211_VERSION;
SOURCE|    return kIOReturnNotReady;
CALLS_APPLE_INFRA_ENABLE=NO
CALLS_APPLE_INFRA_DISABLE=NO
CALLS_SKYWALK_SETTER=NO
