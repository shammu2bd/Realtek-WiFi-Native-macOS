CALLS_PACKET_PATH_ACTIVATE=NO
CALLS_PACKET_PATH_QUIESCE=NO

METHOD=RTW88WCLController::setPOWER
METHOD_STATUS=FOUND
SOURCE|    (void)interface;
SOURCE|    return data ? kIOReturnNotReady : kIOReturnBadArgument;
