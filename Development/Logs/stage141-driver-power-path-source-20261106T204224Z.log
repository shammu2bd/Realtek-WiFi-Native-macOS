SOURCE|IOReturn RTW88WCLInfraInterface::getCHANNEL(apple80211_channel_data *data)
SOURCE|{
SOURCE|    if (!data) return kIOReturnBadArgument;
SOURCE|    if (!_bridge.isAttached()) return kIOReturnNotReady;
SOURCE|    RTW88BSS bss = {};
SOURCE|    IOReturn status = _bridge.copyCurrentBSS(&bss);
SOURCE|    if (status != kIOReturnSuccess) return status;
SOURCE|    if (bss.channel == 0 || bss.channel > 196) return kIOReturnNotReady;
SOURCE|    bzero(data, sizeof(*data));
SOURCE|    data->version = APPLE80211_VERSION;
SOURCE|    data->channel.version = APPLE80211_VERSION;
SOURCE|    data->channel.channel = bss.channel;
SOURCE|    data->channel.flags = bss.channel <= 14 ? APPLE80211_C_FLAG_2GHZ
SOURCE|                                             : APPLE80211_C_FLAG_5GHZ;
SOURCE|    data->channel.flags |= APPLE80211_C_FLAG_20MHZ;
SOURCE|    return kIOReturnSuccess;
SOURCE|}
SOURCE|IOReturn RTW88WCLInfraInterface::getRSSI(apple80211_rssi_data *data)
SOURCE|{
SOURCE|    if (!data) return kIOReturnBadArgument;
SOURCE|    if (!_bridge.isAttached()) return kIOReturnNotReady;
SOURCE|    int rssi = 0;
SOURCE|    IOReturn status = _bridge.getRSSI(&rssi);
SOURCE|    if (status != kIOReturnSuccess) return status;
SOURCE|    bzero(data, sizeof(*data));
SOURCE|    data->version = APPLE80211_VERSION;
SOURCE|    data->num_radios = 1;
SOURCE|    data->rssi_unit = APPLE80211_UNIT_DBM;
SOURCE|    data->rssi[0] = rssi;
SOURCE|    data->aggregate_rssi = rssi;
SOURCE|    return kIOReturnSuccess;
SOURCE|}
SOURCE|IOReturn RTW88WCLInfraInterface::getSUPPORTED_CHANNELS(
SOURCE|    apple80211_sup_channel_data *data)
SOURCE|{
SOURCE|    if (!data) return kIOReturnBadArgument;
SOURCE|    if (!_bridge.isAttached()) return kIOReturnNotReady;
SOURCE|    RTW88Channel channels[APPLE80211_MAX_CHANNELS] = {};
SOURCE|    uint32_t count = 0;
SOURCE|    IOReturn status = _bridge.copyChannels(channels,
SOURCE|                                           APPLE80211_MAX_CHANNELS, &count);
SOURCE|    if (status != kIOReturnSuccess) return status;
SOURCE|    if (count > APPLE80211_MAX_CHANNELS) return kIOReturnNoResources;
SOURCE|    bzero(data, sizeof(*data));
SOURCE|    data->version = APPLE80211_VERSION;
SOURCE|    data->num_channels = count;
SOURCE|    for (uint32_t i = 0; i < count; ++i) {
SOURCE|        if (!channels[i].number || channels[i].number > 196)
SOURCE|            return kIOReturnError;
SOURCE|        data->supported_channels[i].version = APPLE80211_VERSION;
SOURCE|        data->supported_channels[i].channel = channels[i].number;
SOURCE|        data->supported_channels[i].flags = channelFlags(channels[i]);
SOURCE|    }
SOURCE|    return kIOReturnSuccess;
SOURCE|}
SOURCE|IOReturn RTW88WCLInfraInterface::setCIPHER_KEY(apple80211_key *data)
SOURCE|{
SOURCE|    if (!data) return kIOReturnBadArgument;
SOURCE|    if (!_bridge.isAttached()) return kIOReturnNotReady;
SOURCE|    /* The Sequoia WCL protocol uses cipher values PMK (6), PMKSA (7) and MSK
SOURCE|     * (9) here. The RTW88 internal WPA2-PSK path consumes its PMK from the
SOURCE|     * association request and performs the four-way handshake itself. The
SOURCE|     * backend has no WCL PMKSA/MSK cache insertion API yet. Do not reinterpret
SOURCE|     * this message as a PTK/GTK key install. */
SOURCE|    return kIOReturnUnsupported;
SOURCE|}
SOURCE|IOReturn RTW88WCLInfraInterface::setCLEAR_PMKSA_CACHE(void *data)
SOURCE|{
SOURCE|    (void)data;
SOURCE|    /* The existing RTW88 backend does not expose a PMKSA-cache removal API. */
SOURCE|    return kIOReturnUnsupported;
SOURCE|}
SOURCE|IOReturn RTW88WCLInfraInterface::setWCL_LEAVE_NETWORK(
SOURCE|    apple80211_leave_network *data)
SOURCE|{
SOURCE|    (void)data;
SOURCE|    if (!_bridge.isAttached()) return kIOReturnNotReady;
SOURCE|    IOReturn status = _bridge.leaveNetwork();
SOURCE|    if (status == kIOReturnSuccess) {
SOURCE|        /* Invalidate any deferred disconnect callback from the old join. */
SOURCE|        _activeJoinGeneration = 0;
SOURCE|        _connectNotified = false;
SOURCE|        _assocNotified = false;
SOURCE|        setCurrentApAddress(nullptr);
SOURCE|        setLinkState(kIO80211NetworkLinkDown, 0, false, 0);
SOURCE|        RTW88WCLLinkStatusEvent link = {};
SOURCE|        link.up = 0;
SOURCE|        postWCLMessage(kWCLMessageLinkStatus, &link, sizeof(link));
SOURCE|        bzero(_targetBSSID, sizeof(_targetBSSID));
SOURCE|    }
SOURCE|    return status;
SOURCE|}
SOURCE|IOReturn RTW88WCLInfraInterface::setWCL_SCAN_ABORT(void *data)
SOURCE|{
SOURCE|    (void)data;
SOURCE|    if (!_bridge.isAttached()) return kIOReturnNotReady;
SOURCE|    return _bridge.abortScan();
SOURCE|}
SOURCE|IOReturn RTW88WCLInfraInterface::setWCL_JOIN_ABORT(void *data)
SOURCE|{
SOURCE|    (void)data;
SOURCE|    if (!_bridge.isAttached()) return kIOReturnNotReady;
SOURCE|    IOReturn status = _bridge.abortJoin();
SOURCE|    if (status == kIOReturnSuccess) {
SOURCE|        _activeJoinGeneration = 0;
SOURCE|        _assocNotified = false;
SOURCE|        _connectNotified = false;
SOURCE|        postWCLMessage(kWCLMessageJoinAbortComplete, nullptr, 0);
SOURCE|        setCurrentApAddress(nullptr);
SOURCE|        setLinkState(kIO80211NetworkLinkDown, 0, false, 0);
SOURCE|        bzero(_targetBSSID, sizeof(_targetBSSID));
SOURCE|    }
SOURCE|    return status;
SOURCE|}
SOURCE|IOReturn RTW88WCLInfraInterface::setWCL_SCAN_REQ(apple80211ScanRequest *data)
SOURCE|{
SOURCE|    if (!data) return kIOReturnBadArgument;
SOURCE|    if (!_bridge.isAttached() || _stopping) return kIOReturnNotReady;
SOURCE|    if (_scanActive || _bridge.scanInFlight()) return kIOReturnBusy;
SOURCE|    const uint8_t *raw = reinterpret_cast<const uint8_t *>(data);
SOURCE|    const uint32_t channelCount = RTW88WCLRequest::read32(raw + 0x54);
SOURCE|    if (channelCount > 400) return kIOReturnBadArgument;
SOURCE|    const size_t requestLength = 0x58 + static_cast<size_t>(channelCount) * 12;
SOURCE|    RTW88WCLRequest::Scan request = {};
SOURCE|    if (!RTW88WCLRequest::decodeScan(data, requestLength, request))
SOURCE|        return kIOReturnBadArgument;
SOURCE|    /* The backend currently supports active scans only. A FAST request is
SOURCE|     * serviced as a fresh active scan because there is no separate cached-
SOURCE|     * scan transaction; passive/background requests fail closed rather than
SOURCE|     * being silently converted into active probe transmission. */
SOURCE|    if (request.type != APPLE80211_SCAN_TYPE_ACTIVE &&
SOURCE|        request.type != APPLE80211_SCAN_TYPE_FAST)
SOURCE|        return kIOReturnUnsupported;
SOURCE|    uint16_t channels[128] = {};
SOURCE|    uint32_t selected = 0;
SOURCE|    for (unsigned channel = 1; channel <= 196; ++channel) {
SOURCE|        if (!(request.channelBitmap[channel / 8] & (1U << (channel % 8))))
SOURCE|            continue;
SOURCE|        if (selected == sizeof(channels) / sizeof(channels[0]))
SOURCE|            return kIOReturnNoResources;
SOURCE|        channels[selected++] = static_cast<uint16_t>(channel);
SOURCE|    }
SOURCE|    if (request.channelCount != 0 && selected == 0)
SOURCE|        return kIOReturnUnsupported;
SOURCE|    ScanFilter filter = {};
SOURCE|    filter.identifier = request.identifier;
SOURCE|    filter.ssidLength = static_cast<uint8_t>(request.ssidLength);
SOURCE|    memcpy(filter.ssid, request.ssid, sizeof(filter.ssid));
SOURCE|    memcpy(filter.bssid, request.bssid, sizeof(filter.bssid));
SOURCE|    memcpy(filter.channelBitmap, request.channelBitmap,
SOURCE|           sizeof(filter.channelBitmap));
SOURCE|    filter.filterBSSID = !isZeroAddress(filter.bssid, sizeof(filter.bssid));
SOURCE|    filter.filterChannels = request.channelCount != 0;
SOURCE|    _scanFilter = filter;
SOURCE|    _scanActive = true;
SOURCE|    /* The bridge writes this generation before it enters the asynchronous
SOURCE|     * backend, so a fast completion cannot race the interface's filter state. */
SOURCE|    _activeScanGeneration = 0;
SOURCE|    setScanningState(request.identifier, true, nullptr, 0);
SOURCE|    IOReturn status = _bridge.startScan(selected ? channels : nullptr, selected,
SOURCE|                                        &_activeScanGeneration);
SOURCE|    if (status != kIOReturnSuccess) {
SOURCE|        _scanActive = false;
SOURCE|        _activeScanGeneration = 0;
SOURCE|        setScanningState(request.identifier, false, nullptr, 0);
SOURCE|    }
SOURCE|    return status;
METHOD_BODY_END
